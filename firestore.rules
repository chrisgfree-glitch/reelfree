rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read/write only their own documents. Nothing else is readable.
    match /users/{uid}/favorites/{titleId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && titleId.size() <= 80 && request.resource.data.keys().hasOnly(['addedAt']);
    }
    match /users/{uid}/lists/{listId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'items', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.items is list && request.resource.data.items.size() <= 500;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
