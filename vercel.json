{
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)data/status.json'",
  "rewrites": [
    {
      "source": "/title/:id",
      "destination": "/api/title?id=:id"
    },
    {
      "source": "/title",
      "destination": "/tpl/title.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.reelfree.net"
        }
      ],
      "destination": "https://reelfree.net/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-check",
      "schedule": "17 9 * * *"
    },
    {
      "path": "/api/cron-weekly",
      "schedule": "0 16 * * 1"
    }
  ],
  "functions": {
    "api/cron-check.mjs": {
      "maxDuration": 300
    },
    "api/cron-weekly.mjs": {
      "maxDuration": 30
    },
    "api/report.js": {
      "maxDuration": 15
    },
    "api/art.mjs": {
      "maxDuration": 30,
      "includeFiles": "data/titles.json"
    },
    "api/title.mjs": {
      "maxDuration": 10,
      "includeFiles": "{tpl/title.html,data/titles.json}"
    },
    "api/tmdb-search.mjs": {
      "maxDuration": 15
    }
  }
}